# ============================================================================
# NG Admissions — Environment Configuration
# ============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to version control.
# ============================================================================

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated allowed origins (use * for dev)
CORS_ORIGIN=*

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_GENERATE_MAX=30

# Logging
LOG_LEVEL=info

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
# Local dev: path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./your-firebase-adminsdk-key.json
# Production (Render): paste the ENTIRE JSON content as a single line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}
