  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Khaja-Baig/NG-Admissions-Test-Paper-Tool/issues"
  },
  "homepage": "https://github.com/Khaja-Baig/NG-Admissions-Test-Paper-Tool#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "winston": "^3.19.0"
  }
}
