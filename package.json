{
  "name": "project-admission-ng",
  "version": "1.1.0",
  "description": "NG Admissions Test Paper Tool — Rule Engine + API",
  "main": "server/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node tests/testRules.js",
    "test:api": "node tests/testAPI.js",
    "test:rewire": "node tests/testRewire.js",
    "test:all": "node tests/testRules.js && node tests/testAPI.js && node tests/testRewire.js",
    "start": "node server/index.js",
    "build": "npx esbuild rules/bundle-entry.js --bundle --outfile=rules-bundle.js --format=iife --global-name=RuleEngine"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Khaja-Baig/NG-Admissions-Test-Paper-Tool.git"
  },
  "keywords": [],
